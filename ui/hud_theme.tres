[gd_resource type="Theme" format=3]

[ext_resource type="FontFile" path="res://design_ref/fonts/BarlowSemiCondensed-Regular.ttf" id="1_regular"]
[ext_resource type="FontFile" path="res://design_ref/fonts/BarlowSemiCondensed-Medium.ttf" id="2_medium"]
[ext_resource type="FontFile" path="res://design_ref/fonts/BarlowSemiCondensed-SemiBold.ttf" id="3_semibold"]
[ext_resource type="FontFile" path="res://design_ref/fonts/BarlowSemiCondensed-Bold.ttf" id="4_bold"]

[sub_resource type="FontVariation" id="FontVariation_regular"]
base_font = ExtResource("1_regular")
opentype_features = {"tnum": 1}

[sub_resource type="FontVariation" id="FontVariation_medium"]
base_font = ExtResource("2_medium")
opentype_features = {"tnum": 1}

[sub_resource type="FontVariation" id="FontVariation_semibold"]
base_font = ExtResource("3_semibold")
opentype_features = {"tnum": 1}

[sub_resource type="FontVariation" id="FontVariation_bold"]
base_font = ExtResource("4_bold")
opentype_features = {"tnum": 1}

[sub_resource type="FontVariation" id="FontVariation_header"]
base_font = ExtResource("4_bold")
opentype_features = {"tnum": 1}
spacing_glyph = 1

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.05098, 0.07059, 0.08627, 0.97)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 0
corner_radius_bottom_left = 0
corner_detail = 8
anti_aliasing = true

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_slot"]
bg_color = Color(0.109804, 0.164706, 0.2, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.12)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
corner_detail = 8
anti_aliasing = true

[resource]
default_font = SubResource("FontVariation_medium")
default_font_size = 13
HUDFonts/fonts/bold = SubResource("FontVariation_bold")
HUDFonts/fonts/header = SubResource("FontVariation_header")
HUDFonts/fonts/medium = SubResource("FontVariation_medium")
HUDFonts/fonts/regular = SubResource("FontVariation_regular")
HUDFonts/fonts/semibold = SubResource("FontVariation_semibold")
HUDPanel/base_type = &"PanelContainer"
HUDPanel/styles/panel = SubResource("StyleBoxFlat_panel")
HUDSlot/base_type = &"PanelContainer"
HUDSlot/styles/panel = SubResource("StyleBoxFlat_slot")
Label/colors/font_color = Color(0.933333, 0.94902, 0.956863, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.45)
Label/constants/shadow_offset_x = 0
Label/constants/shadow_offset_y = 1
Label/font_sizes/font_size = 13
Label/fonts/font = SubResource("FontVariation_medium")
