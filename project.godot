; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MMO Prototype Client"
run/main_scene="res://bootstrap.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ProyectoB"
config/features=PackedStringArray("4.6", "4.6.1", "Forward Plus")
run/low_processor_mode_sleep_usec=0
config/icon="res://icon.svg"
run/multiple_instances=true

[autoload]
GameConfig="*res://config/game_config.gd"

AuthManager="*res://shared-core/AuthManager.gd"
NetworkManager="*res://shared-core/NetworkManager.gd"
SceneManager="*res://shared-core/SceneManager.gd"
APIClient="*res://shared-core/APIClient.gd"
ShelterManager="*res://shared-core/ShelterManager.gd"
UpdateManager="*res://shared-core/UpdateManager.gd"
ItemManager="*res://shared-core/ItemManager.gd"
KnowledgeService="*res://shared-core/KnowledgeService.gd"
ShelterService="*res://shared-core/ShelterService.gd"
QuestService="*res://shared-core/QuestService.gd"
WorldMapService="*res://shared-core/WorldMapService.gd"
SocialService="*res://shared-core/SocialService.gd"
CommerceService="*res://shared-core/CommerceService.gd"
UIOrchestrator="*res://ui/orchestration/UIOrchestrator.gd"
InventoryController="*res://ui/controllers/InventoryController.gd"
InputSettings="*res://ui/orchestration/InputSettings.gd"
UIInputRouter="*res://ui/orchestration/UIInputRouter.gd"
TargetManager="*res://shared-core/TargetManager.gd"
SpellManager="*res://shared-core/SpellManager.gd"
ScreenSpaceManager="*res://ui/screenspace/ScreenSpaceManager.gd"
SoundManager="*res://audio/SoundManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

